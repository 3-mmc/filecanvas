#!/usr/bin/env python3
"""msgcanvas: this launcher runs the package next to it (msgcanvas/), so it works from a symlink
on your PATH: ln -s "$PWD/msgcanvas-launcher" ~/.local/bin/msgcanvas"""
import os, sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from msgcanvas.__main__ import main

main()
